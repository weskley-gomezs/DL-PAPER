rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'weskleyg4000@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isValidProduto(data) {
      return data.keys().hasAll(['nome', 'precoVenda', 'categoriaLinha'])
        && data.keys().hasOnly(['nome', 'precoVenda', 'categoriaLinha', 'descricao', 'imagemUrl', 'exibirNoSite'])
        && data.nome is string
        && data.nome.size() >= 1
        && data.nome.size() <= 200
        && data.precoVenda is number
        && data.precoVenda >= 0
        && data.precoVenda <= 1000000
        && data.categoriaLinha is string
        && data.categoriaLinha in ['pessoal', 'corporativo', 'ambos']
        && (!('descricao' in data) || (data.descricao is string && data.descricao.size() <= 2000))
        && (!('imagemUrl' in data) || (data.imagemUrl is string && data.imagemUrl.size() <= 2048))
        && (!('exibirNoSite' in data) || data.exibirNoSite is bool);
    }

    // Public read-only storefront catalog; writes restricted to admins
    match /produtos/{produtoId} {
      allow get: if isValidId(produtoId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(produtoId) && isValidProduto(incoming());
      allow update: if isAdmin()
        && isValidId(produtoId)
        && isValidProduto(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'nome',
          'precoVenda',
          'categoriaLinha',
          'descricao',
          'imagemUrl',
          'exibirNoSite'
        ]);
      allow delete: if isAdmin() && isValidId(produtoId);
    }

    // Admin lookup collection (read-only by owner UID)
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && request.auth.uid == adminId;
      allow list, write: if false;
    }

    // Connection check document
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }
  }
}
