rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email == 'weskleyg4000@gmail.com' && request.auth.token.email_verified == true)
      );
    }

    function isValidProduto(data) {
      return data.keys().hasAll(['nome', 'precoVenda', 'categoriaLinha'])
        && data.keys().hasOnly(['nome', 'precoVenda', 'categoriaLinha', 'descricao', 'imagemUrl', 'exibirNoSite'])
        && data.nome is string
        && data.nome.size() >= 1
        && data.nome.size() <= 200
        && data.precoVenda is number
        && data.precoVenda >= 0
        && data.precoVenda <= 1000000
        && data.categoriaLinha is string
        && data.categoriaLinha in ['pessoal', 'corporativo', 'ambos']
        && (!('descricao' in data) || (data.descricao is string && data.descricao.size() <= 2000))
        && (!('imagemUrl' in data) || (data.imagemUrl is string && data.imagemUrl.size() <= 900000))
        && (!('exibirNoSite' in data) || data.exibirNoSite is bool);
    }

    // Public read-only storefront catalog; writes restricted to admins
    match /produtos/{produtoId} {
      allow get: if isValidId(produtoId);
      allow list: if true;
      allow create: if isAdmin() && isValidId(produtoId) && isValidProduto(incoming());
      allow update: if isAdmin()
        && isValidId(produtoId)
        && isValidProduto(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'nome',
          'precoVenda',
          'categoriaLinha',
          'descricao',
          'imagemUrl',
          'exibirNoSite'
        ]);
      allow delete: if isAdmin() && isValidId(produtoId);
    }

    function isValidSiteConfigSection(sectionId) {
      return isValidId(sectionId) && sectionId in ['principal', 'geral', 'banners', 'testimonials', 'galleries', 'galleries_feminina', 'galleries_masculina', 'themes'];
    }

    function isValidGeralPayload(data) {
      return data.keys().hasOnly([
          'logo',
          'heroImage',
          'heroVideo',
          'aboutImage',
          'partyFavorsImage',
          'whatsappNumber',
          'whatsappFormatted',
          'instagramHandle',
          'instagramUrl',
          'isComingSoon',
          'comingSoonTitle',
          'comingSoonSubtitle',
          'heroTexts',
          'aboutTexts',
          'kitGalleryFeminina',
          'kitGalleryMasculina',
          'themes',
          'updatedAt'
        ])
        && data.updatedAt is number
        && data.updatedAt > 0
        && (!('logo' in data) || (data.logo is string && data.logo.size() <= 900000))
        && (!('heroImage' in data) || (data.heroImage is string && data.heroImage.size() <= 900000))
        && (!('heroVideo' in data) || (data.heroVideo is string && data.heroVideo.size() <= 2048))
        && (!('aboutImage' in data) || (data.aboutImage is string && data.aboutImage.size() <= 900000))
        && (!('partyFavorsImage' in data) || (data.partyFavorsImage is string && data.partyFavorsImage.size() <= 900000))
        && (!('whatsappNumber' in data) || (data.whatsappNumber is string && data.whatsappNumber.size() <= 30))
        && (!('whatsappFormatted' in data) || (data.whatsappFormatted is string && data.whatsappFormatted.size() <= 40))
        && (!('instagramHandle' in data) || (data.instagramHandle is string && data.instagramHandle.size() <= 80))
        && (!('instagramUrl' in data) || (data.instagramUrl is string && data.instagramUrl.size() <= 512))
        && (!('isComingSoon' in data) || data.isComingSoon is bool)
        && (!('comingSoonTitle' in data) || (data.comingSoonTitle is string && data.comingSoonTitle.size() <= 200))
        && (!('comingSoonSubtitle' in data) || (data.comingSoonSubtitle is string && data.comingSoonSubtitle.size() <= 1000))
        && (!('heroTexts' in data) || data.heroTexts is map)
        && (!('aboutTexts' in data) || data.aboutTexts is map)
        && (!('kitGalleryFeminina' in data) || (data.kitGalleryFeminina is list && data.kitGalleryFeminina.size() <= 40))
        && (!('kitGalleryMasculina' in data) || (data.kitGalleryMasculina is list && data.kitGalleryMasculina.size() <= 40))
        && (!('themes' in data) || (data.themes is list && data.themes.size() <= 50));
    }

    function isValidItemsSectionPayload(data) {
      return data.keys().hasAll(['items', 'updatedAt'])
        && data.keys().hasOnly(['items', 'updatedAt'])
        && data.updatedAt is number
        && data.updatedAt > 0
        && data.items is list
        && data.items.size() <= 50;
    }

    function isValidGalleriesPayload(data) {
      return data.keys().hasOnly(['feminina', 'masculina', 'updatedAt'])
        && data.updatedAt is number
        && data.updatedAt > 0
        && (!('feminina' in data) || (data.feminina is list && data.feminina.size() <= 40))
        && (!('masculina' in data) || (data.masculina is list && data.masculina.size() <= 40));
    }

    function isValidSiteConfigPayload(data, sectionId) {
      return (sectionId in ['principal', 'geral'] && isValidGeralPayload(data))
        || (sectionId in ['banners', 'testimonials', 'themes', 'galleries_feminina', 'galleries_masculina'] && isValidItemsSectionPayload(data))
        || (sectionId == 'galleries' && isValidGalleriesPayload(data));
    }

    // Storefront visual configuration sections (principal, geral, banners, testimonials, galleries, themes)
    match /site_config/{sectionId} {
      allow get: if isValidSiteConfigSection(sectionId);
      allow list: if true;
      allow create: if isAdmin()
        && isValidSiteConfigSection(sectionId)
        && isValidSiteConfigPayload(incoming(), sectionId);
      allow update: if isAdmin()
        && isValidSiteConfigSection(sectionId)
        && isValidSiteConfigPayload(incoming(), sectionId)
        && (
          (sectionId in ['principal', 'geral'] && incoming().diff(existing()).affectedKeys().hasOnly([
            'logo', 'heroImage', 'heroVideo', 'aboutImage', 'partyFavorsImage',
            'whatsappNumber', 'whatsappFormatted', 'instagramHandle', 'instagramUrl',
            'isComingSoon', 'comingSoonTitle', 'comingSoonSubtitle', 'heroTexts', 'aboutTexts',
            'kitGalleryFeminina', 'kitGalleryMasculina', 'themes', 'updatedAt'
          ])) ||
          (sectionId == 'galleries' && incoming().diff(existing()).affectedKeys().hasOnly([
            'feminina', 'masculina', 'updatedAt'
          ])) ||
          (sectionId in ['banners', 'testimonials', 'themes', 'galleries_feminina', 'galleries_masculina'] && incoming().diff(existing()).affectedKeys().hasOnly([
            'items', 'updatedAt'
          ]))
        );
      allow delete: if false;
    }

    // Banners collection (public read, admin write)
    match /banners/{bannerId} {
      allow get: if isValidId(bannerId);
      allow list: if true;
      allow create, update: if isAdmin()
        && isValidId(bannerId)
        && incoming().keys().hasAll(['src', 'title', 'updatedAt'])
        && incoming().keys().hasOnly(['src', 'title', 'subtitle', 'order', 'updatedAt'])
        && incoming().src is string && incoming().src.size() <= 900000
        && incoming().title is string && incoming().title.size() <= 200
        && (!('subtitle' in incoming()) || (incoming().subtitle is string && incoming().subtitle.size() <= 400))
        && (!('order' in incoming()) || incoming().order is number)
        && incoming().updatedAt is number;
      allow delete: if isAdmin() && isValidId(bannerId);
    }

    // Feedbacks collection (public read, admin write)
    match /feedbacks/{feedbackId} {
      allow get: if isValidId(feedbackId);
      allow list: if true;
      allow create, update: if isAdmin()
        && isValidId(feedbackId)
        && incoming().keys().hasAll(['url', 'updatedAt'])
        && incoming().keys().hasOnly(['url', 'alt', 'order', 'updatedAt'])
        && incoming().url is string && incoming().url.size() <= 900000
        && (!('alt' in incoming()) || (incoming().alt is string && incoming().alt.size() <= 300))
        && (!('order' in incoming()) || incoming().order is number)
        && incoming().updatedAt is number;
      allow delete: if isAdmin() && isValidId(feedbackId);
    }

    // Admin lookup collection (read-only by owner UID)
    match /admins/{adminId} {
      allow get: if isSignedIn() && isValidId(adminId) && request.auth.uid == adminId;
      allow list, write: if false;
    }

    // Connection check document
    match /test/connection {
      allow get: if true;
      allow list, write: if false;
    }
  }
}
